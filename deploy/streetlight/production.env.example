# Copy to production.env on the host. Never commit the populated file.
NODE_ENV=production
SERVER_URL=https://crm.example.org
FRONTEND_URL=https://crm.example.org

# Use a managed PostgreSQL 16+ database with TLS and a dedicated user.
PG_DATABASE_URL=postgres://streetlight:replace-me@postgres.example.org:5432/streetlight?sslmode=require
REDIS_URL=rediss://default:replace-me@redis.example.org:6379
REDIS_CACHE_PREFIX=streetlight:

# Generate independent high-entropy values and preserve them in a secret manager.
APP_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-32-byte-hex-key

# R2 is S3-compatible. Use a narrowly scoped bucket credential.
STORAGE_TYPE=s3
STORAGE_S3_REGION=auto
STORAGE_S3_NAME=streetlight-crm
STORAGE_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_S3_ACCESS_KEY_ID=replace-me
STORAGE_S3_SECRET_ACCESS_KEY=replace-me

# Streetlight logic functions are trusted application code. For customer-supplied
# functions, use Lambda or another isolated runner instead of LOCAL.
LOGIC_FUNCTION_TYPE=LOCAL
EMAIL_DRIVER=SMTP
EMAIL_FROM_ADDRESS=crm@example.org
EMAIL_FROM_NAME=Streetlight CRM
EMAIL_SMTP_HOST=smtp.example.org
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=replace-me
EMAIL_SMTP_PASSWORD=replace-me

IS_BILLING_ENABLED=false
IS_MULTIWORKSPACE_ENABLED=false
IS_CONFIG_VARIABLES_IN_DB_ENABLED=false
