# Copy to selfhosted.env on the host (chmod 600). Never commit the populated file.
# scripts/streetlight/selfhosted-init-env.sh generates the secrets below.
STREETLIGHT_IMAGE=streetlight-crm:replace-with-git-sha

NODE_ENV=production
SERVER_URL=https://streetlight.example.ts.net
FRONTEND_URL=https://streetlight.example.ts.net

# Alphanumeric only: it is embedded in PG_DATABASE_URL unescaped.
PG_DATABASE_PASSWORD=replace-me
REDIS_CACHE_PREFIX=streetlight:

# Back up ENCRYPTION_KEY off the host; losing it makes stored credentials unrecoverable.
APP_SECRET=replace-me
ENCRYPTION_KEY=replace-me

STORAGE_TYPE=local
LOGIC_FUNCTION_TYPE=LOCAL

# LOGGER writes outbound mail to the server log. Switch to SMTP once a mailbox is ready.
EMAIL_DRIVER=LOGGER
EMAIL_FROM_ADDRESS=crm@example.org
EMAIL_FROM_NAME=Streetlight CRM
# EMAIL_SMTP_HOST=smtp.example.org
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=replace-me
# EMAIL_SMTP_PASSWORD=replace-me

IS_BILLING_ENABLED=false
IS_MULTIWORKSPACE_ENABLED=false
IS_CONFIG_VARIABLES_IN_DB_ENABLED=false
