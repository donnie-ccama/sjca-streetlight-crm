# Copy to sjca.env on the server. Never commit the populated file.
NODE_ENV=production
STREETLIGHT_IMAGE=replace-me
SERVER_URL=https://sjca.dev
FRONTEND_URL=https://sjca.dev

# Supabase provides PostgreSQL. This is the session pooler (IPv4) on port 5432.
# Do not use the transaction pooler on port 6543.
PG_DATABASE_URL=postgres://postgres.PROJECT_REF:replace-me@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# The pg driver rejects the Supabase CA chain. Keep TLS on and skip the CA check.
# Do not add sslmode to the URL, because it overrides this setting.
PG_SSL_ALLOW_SELF_SIGNED=true
# The Supabase session pooler has a small client limit. Close idle connections after 30 seconds.
PG_POOL_IDLE_TIMEOUT_MS=30000
REDIS_URL=redis://redis:6379
REDIS_CACHE_PREFIX=streetlight:

# Generate independent high-entropy values and keep them in a secret manager.
APP_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-32-byte-hex-key

# R2 is S3-compatible. Use a narrowly scoped bucket credential.
STORAGE_TYPE=s3
STORAGE_S3_REGION=auto
STORAGE_S3_NAME=sjca-crm-files
STORAGE_S3_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
STORAGE_S3_ACCESS_KEY_ID=replace-me
STORAGE_S3_SECRET_ACCESS_KEY=replace-me

# Logic functions are trusted application code. Do not run customer code with LOCAL.
LOGIC_FUNCTION_TYPE=LOCAL
EMAIL_DRIVER=SMTP
EMAIL_FROM_ADDRESS=crm@sjca.dev
EMAIL_FROM_NAME=Streetlight CRM
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=replace-me
EMAIL_SMTP_PASSWORD=replace-me

# Google sign-in, Gmail sync, and Google Calendar sync.
AUTH_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID=replace-me
AUTH_GOOGLE_CLIENT_SECRET=replace-me
AUTH_GOOGLE_CALLBACK_URL=https://sjca.dev/auth/google/redirect
AUTH_GOOGLE_APIS_CALLBACK_URL=https://sjca.dev/auth/google-apis/get-access-token
MESSAGING_PROVIDER_GMAIL_ENABLED=true
CALENDAR_PROVIDER_GOOGLE_ENABLED=true

IS_BILLING_ENABLED=false
IS_MULTIWORKSPACE_ENABLED=false
IS_CONFIG_VARIABLES_IN_DB_ENABLED=true

# Cloudflare Tunnel token for the cloudflared service.
TUNNEL_TOKEN=replace-me
