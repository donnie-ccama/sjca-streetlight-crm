{
  "NODE_ENV": "production",
  "SERVER_URL": "https://crm.organization.example",
  "FRONTEND_URL": "https://crm.organization.example",
  "PG_DATABASE_URL": "postgres://organization_streetlight:replace-me@postgres.organization.example:5432/organization_streetlight?sslmode=require",
  "REDIS_URL": "rediss://default:replace-me@redis-cache.organization.example:6379",
  "REDIS_CACHE_PREFIX": "organization-streetlight:",
  "REDIS_QUEUE_URL": "rediss://default:replace-me@redis-queue.organization.example:6379",
  "REDIS_QUEUE_PREFIX": "{organization-streetlight}",
  "APP_SECRET": "replace-with-at-least-32-random-characters",
  "ENCRYPTION_KEY": "replace-with-a-64-character-lowercase-hex-value",
  "STORAGE_TYPE": "s3",
  "STORAGE_S3_REGION": "auto",
  "STORAGE_S3_NAME": "organization-streetlight-crm",
  "STORAGE_S3_ENDPOINT": "https://ACCOUNT_ID.r2.cloudflarestorage.com",
  "STORAGE_S3_ACCESS_KEY_ID": "replace-me",
  "STORAGE_S3_SECRET_ACCESS_KEY": "replace-me",
  "LOGIC_FUNCTION_TYPE": "DISABLED",
  "EMAIL_DRIVER": "SMTP",
  "EMAIL_FROM_ADDRESS": "crm@organization.example",
  "EMAIL_FROM_NAME": "Streetlight CRM",
  "EMAIL_SMTP_HOST": "smtp.organization.example",
  "EMAIL_SMTP_PORT": "465",
  "EMAIL_SMTP_USER": "replace-me",
  "EMAIL_SMTP_PASSWORD": "replace-me",
  "IS_BILLING_ENABLED": "false",
  "IS_MULTIWORKSPACE_ENABLED": "false",
  "IS_CONFIG_VARIABLES_IN_DB_ENABLED": "false"
}
